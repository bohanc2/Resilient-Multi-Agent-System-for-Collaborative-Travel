# ==============================================================================
# Multi-Agent Collaborative Travel Planning Engine - Environment Configuration
# ==============================================================================

# --- LLM Provider API Keys (At least one required for live LLM planning) ---
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Live Data Providers ---
# Set to 'true' to enable live Open-Meteo weather and OSRM routing.
# If external APIs time out (>3s) or fail, system automatically falls back to curated snapshots.
USE_LIVE_APIS=true

# Optional: Google Places API Key for live global venue search across any city.
# If empty, the system automatically uses OpenStreetMap Nominatim/Overpass (free) & local snapshots.
GOOGLE_PLACES_API_KEY=

# --- Server & Cloud Deployment Settings ---
PORT=8000

# Allowed CORS Origins (comma-separated). Supports wildcard patterns like https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app
